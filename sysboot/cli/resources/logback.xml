<?xml version="1.0" encoding="UTF-8"?>
<!--
  Diagnostics go to stderr, never stdout.

  stdout carries the execution report and, with `--format json`, machine-readable output. A DEBUG
  line printed there corrupts both. Without this configuration Logback defaults to DEBUG on stdout,
  which interleaved framework logging with the item lines it was meant to describe.

  The level is driven by the `fluxion.log.level` property, which Main sets from the verbose flag.
-->
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%-5level %logger{0} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="${fluxion.log.level:-WARN}">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
